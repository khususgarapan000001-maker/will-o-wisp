# WILL-O'-WISP — environment template.
# Copy to `.env.local` and fill in real values. Never commit `.env.local`.
# Supabase project: will-o-wisp (Singapore), ref hdkuhnwvufndcsikmdil.
# Values live in the dashboard: Project Settings → API.

# Supabase (public — safe to expose in the browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Supabase service-role key — SERVER ONLY. Never import into client code.
# Used only by Edge Functions (heartbeat cron) and seed scripts.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Resend (email for heartbeat nudges + keeper notifications)
RESEND_API_KEY=YOUR_RESEND_API_KEY
RESEND_FROM_EMAIL=WILL-O'-WISP <lantern@yourdomain.example>

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Demo mode — enables the demo clock + demo account seeding.
# Never enable in production; demo-only code is gated behind this flag.
DEMO_MODE=false

# Demo clock: the only account allowed to advance time when DEMO_MODE=true.
DEMO_ACCOUNT_EMAIL=demo@will-o-wisp.example

# Edge Function heartbeat-tick (set with `supabase secrets set`, not here):
#   HEARTBEAT_CRON_SECRET, APP_URL, RESEND_API_KEY, RESEND_FROM_EMAIL, DEMO_MODE
